{
  "about": "Check 1. The puzzle token must be valid for exactly this submission, and dated today or yesterday.",
  "steps": [
    {
      "note": "no token is a malformed call",
      "as": "conn",
      "method": "POST",
      "path": "/v1/edits",
      "send": {
        "contract": "v1",
        "target": "catalog/sample-calculator/description",
        "change": "The sample description should say which made-up rule it follows.",
        "reason": "It reads as if no rule applies.",
        "pow": "",
        "honeypot": "",
        "source": "203.0.113.7"
      },
      "status": 400,
      "want": {
        "error": "E_PARSE",
        "reason": "a required field is missing or malformed"
