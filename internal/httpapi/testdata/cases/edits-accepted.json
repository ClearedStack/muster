          "change": "The sample description should say which made-up rule it follows.",
          "reason": "It reads as if no rule applies."
        }
      }
    },
    {
      "as": "bellbuoy",
      "method": "POST",
      "path": "/v1/complete",
      "send": {
        "contract": "v1",
        "lease": "EP-0001.4.1",
        "state": "building"
      },
      "status": 200,
      "want": {
        "id": "EP-0001",
        "state": "building"
      }
    },
    {
      "as": "bellbuoy",
      "method": "POST",
      "path": "/v1/lease",
      "send": {
        "contract": "v1"
      },
      "status": 200,
      "want": {
        "lease": "EP-0002.5.1",
        "kind": "proposal",
        "id": "EP-0002",
        "state": "approved",
        "lane": "urgent",
        "attempt": 1,
        "expires": "2026-01-05T09:01:00Z",
        "proposal": {
          "target": "sextant.sample-portal.options",
          "repository": "sextant",
          "file": "tools/sample-portal/options.json",
          "edit_kind": "CONFIG",
          "change": "Set the made-up option to 3.",
          "reason": ""
        }
      }
    },
    {
      "note": "going live is not Bellbuoy's move",
      "as": "bellbuoy",
      "method": "POST",
      "path": "/v1/complete",
      "send": {
        "contract": "v1",
        "lease": "EP-0002.5.1",
        "state": "live"
      },
      "status": 409,
      "want": {
        "error": "E_PARSE",
        "cause": "move_not_allowed",
        "reason": "that move is not allowed"
      }
    },
    {
      "as": "bellbuoy",
      "method": "POST",
      "path": "/v1/complete",
      "send": {
        "contract": "v1",
        "lease": "EP-0002.5.1",
        "state": "building"
      },
      "status": 200,
      "want": {
        "id": "EP-0002",
        "state": "building"
      }
    },
    {
      "note": "nothing else is Bellbuoy's",
      "as": "bellbuoy",
      "method": "POST",
      "path": "/v1/lease",
      "send": {
        "contract": "v1"
      },
      "status": 204
