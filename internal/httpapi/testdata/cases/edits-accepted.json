    {
      "note": "the first digest ever reported for a component is only noted",
      "as": "shipkeeper",
      "method": "POST",
      "path": "/v1/health",
      "send": {
        "contract": "v1",
        "reports": [
          {
            "component": "conn",
            "state": "healthy",
            "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
          },
          {
            "component": "sextant",
            "state": "healthy",
            "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
          }
        ]
      },
      "status": 200,
      "want": {
        "received": 2,
        "replayed": 0,
        "live": 0
      }
    },
    {
      "note": "a new digest for Conn: the proposal building in its repository goes live",
      "as": "shipkeeper",
      "method": "POST",
      "path": "/v1/health",
      "send": {
        "contract": "v1",
        "reports": [
          {
            "component": "conn",
            "state": "healthy",
            "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
          }
        ]
      },
      "status": 200,
      "want": {
        "received": 1,
        "replayed": 0,
        "live": 1
      }
    },
    {
      "note": "once",
      "as": "shipkeeper",
      "method": "POST",
      "path": "/v1/health",
      "send": {
        "contract": "v1",
        "reports": [
          {
            "component": "conn",
            "state": "healthy",
            "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
          }
        ]
      },
      "status": 200,
      "want": {
        "received": 1,
        "replayed": 0,
        "live": 0
      }
    },
    {
      "note": "a refused batch changes nothing",
      "as": "shipkeeper",
      "method": "POST",
      "path": "/v1/health",
      "send": {
        "contract": "v1",
        "reports": [
          {
            "component": "assay",
            "state": "healthy",
            "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
          },
          {
            "component": "assay2",
            "state": "healthy"
          }
        ]
