    },
    {
      "note": "a new digest for Sextant: its proposal goes live too",
      "as": "shipkeeper",
      "method": "POST",
      "path": "/v1/health",
      "send": {
        "contract": "v1",
        "reports": [
          {
            "component": "sextant",
            "state": "healthy",
            "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
          }
        ]
      },
      "status": 200,
      "want": {
        "received": 1,
        "replayed": 0,
        "live": 1
      }
    }
  ]
